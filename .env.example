# Postgres (docker compose up -d db)
DATABASE_URL=postgres://app:app@localhost:5432/class_attitude

# Better Auth — secret en az 32 karakter olmalı: `openssl rand -base64 32`
BETTER_AUTH_SECRET=change-me-to-a-random-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:3000

# Web Push (VAPID) — `pnpm push:keys` ile üret. Boş bırakılırsa push kapalıdır, uygulama içi bildirimler çalışır.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# İletişim adresi (push servisleri sorun olursa buraya yazar)
VAPID_SUBJECT=mailto:okul@example.com
