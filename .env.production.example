# Üretim ayarları (docs/DEPLOY.md). Sunucuda bu dosyayı .env olarak kopyalayıp doldurun:
#   cp .env.production.example .env && chmod 600 .env
# Rastgele değer üretmek için: openssl rand -base64 32

# Uygulamanın adresi (DNS A/AAAA kaydı bu sunucuyu göstermeli) ve Let's Encrypt bildirim adresi
DOMAIN=gelisim.okulunuz.k12.tr
ACME_EMAIL=bilgi@okulunuz.k12.tr

# Veritabanı
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=class_attitude

# Oturum imzası (en az 32 karakter). Değiştirilirse herkesin oturumu kapanır.
BETTER_AUTH_SECRET=

# Web Push (isteğe bağlı): `pnpm push:keys` ile üretin. Boşsa anlık bildirim kapalıdır.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bilgi@okulunuz.k12.tr

# Yedekleme: yedekleri şifreleyen parola. KAYBEDİLİRSE YEDEKLER AÇILAMAZ; sunucu dışında saklayın.
BACKUP_PASSPHRASE=
# cron biçimi, Türkiye saati (varsayılan her gece 02:30) ve sunucuda saklama süresi (gün)
BACKUP_SCHEDULE=30 2 * * *
BACKUP_RETENTION_DAYS=14

# Uzak kopya (isteğe bağlı): S3 uyumlu depolama. Boş bırakılırsa yalnızca sunucuda tutulur.
# RCLONE_REMOTE=uzak:kova-adi/gelisim
# RCLONE_CONFIG_UZAK_TYPE=s3
# RCLONE_CONFIG_UZAK_PROVIDER=Other
# RCLONE_CONFIG_UZAK_ENDPOINT=https://s3.saglayici.com.tr
# RCLONE_CONFIG_UZAK_ACCESS_KEY_ID=
# RCLONE_CONFIG_UZAK_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_UZAK_REGION=
